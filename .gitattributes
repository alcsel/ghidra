# Tum metin dosyalarinda satir sonlarini normalize et
* text=auto

# Kabuk betikleri LF olmali
gradlew text eol=lf
*.sh text eol=lf

# Windows betikleri CRLF olmali
*.bat text eol=crlf
*.ps1 text eol=crlf

# Kaynak ve yapilandirma
*.java text
*.gradle text
*.properties text
*.xml text
*.md text

